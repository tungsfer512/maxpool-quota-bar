{
  "name": "maxpool-claude-quota-bar",
  "displayName": "Maxpool Claude Quota Bar",
  "description": "Monitor real-time session and weekly token usage across multiple Claude accounts via Maxpool directly in the VS Code status bar.",
  "version": "1.3.0",
  "publisher": "tungsfer512",
  "icon": "images/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tungsfer512/maxpool-quota-bar"
  },
  "homepage": "https://github.com/tungsfer512/maxpool-quota-bar#readme",
  "bugs": {
    "url": "https://github.com/tungsfer512/maxpool-quota-bar/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "maxpool",
    "quota",
    "token",
    "status-bar"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "maxpoolQuota.refreshNow",
        "title": "Maxpool: Refresh Claude Quota Now"
      }
    ],
    "configuration": {
      "title": "Maxpool Claude Quota Bar",
      "properties": {
        "maxpoolQuota.binaryPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to the maxpool executable (leave empty for auto-detection)."
        },
        "maxpoolQuota.refreshIntervalSeconds": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "description": "Auto-refresh interval in seconds."
        },
        "maxpoolQuota.statusBarNameLength": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "description": "Maximum number of characters shown for each account name in the status bar. Longer names are cut and end with \"…\". The hover card always shows full names. Set to 0 to never cut names."
        }
      }
    }
  }
}
